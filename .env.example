# 2. DERIBIT (Crypto Options, Futures, Volatility Surface, Greeks)
# Get keys at: https://www.deribit.com/ or https://test.deribit.com/
DERIBIT_CLIENT_ID=""
DERIBIT_CLIENT_SECRET=""
# Set to "true" for testnet (https://test.deribit.com), "false" for production
DERIBIT_TESTNET="true"

# 3. DELTA EXCHANGE (Crypto Derivatives, Futures, Options)
# Get keys at: https://www.delta.exchange/
DELTA_API_KEY=""
DELTA_API_SECRET=""
# Base URL: http://107.173.67.203:8080 (via static VPS proxy) or https://api.delta.exchange
DELTA_BASE_URL="http://107.173.67.203:8080"

# 4. SUPABASE CONFIGURATION
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
